# Copy to .env.local for development. In Vercel, set these per environment
# (Production and Preview) under Settings → Environment Variables.

# The site's public address, no trailing slash. Used for canonical links,
# the sitemap and social previews (NEXT_PUBLIC_…), and for Stripe's return
# links (SITE_URL). Without them Vercel's own domain is used.
NEXT_PUBLIC_SITE_URL=https://bienavenidas.com
SITE_URL=https://bienavenidas.com

# Stripe: secret key (sk_test_… or sk_live_…) and the signing secret of the
# webhook registered at https://<site>/api/stripe/webhook (whsec_…).
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Supabase: project URL and the server-side secret key (sb_secret_…).
# Older projects call it the service role key; either name works.
SUPABASE_URL=
SUPABASE_SECRET_KEY=
# SUPABASE_SERVICE_ROLE_KEY=
