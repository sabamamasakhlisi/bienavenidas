# Copy to .env.local and fill in. Never commit real keys.

# Stripe secret key (use sk_test_… while testing). Leave empty to keep checkout off.
STRIPE_SECRET_KEY=

# Optional: public base URL used for Stripe's return links, e.g. https://bienavenidas.com
SITE_URL=

# Stripe webhook signing secret (whsec_…), from the endpoint registered for
# https://<site>/api/stripe/webhook. Paid orders are recorded only when set.
STRIPE_WEBHOOK_SECRET=

# Supabase project URL and service-role (secret) key. Server only: never expose
# the service-role key to the browser. Leave empty to skip stock and orders.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
